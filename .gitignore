# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebooks (except documentation ones)
.ipynb_checkpoints
# Ignore most notebooks but allow specific important ones
*.ipynb
# Allow documentation/example notebooks
!docs/examples/*.ipynb
!tutorials/*.ipynb

# Data files (large datasets)
data/raw/
data/processed/
data/embeddings/
data/models/
data/cache/
# Allow example/test data
!data/examples/
!data/test/

# Model files (typically large)
models/*.pkl
models/*.joblib
models/*.h5
models/*.ckpt
models/*.pth
models/*.bin
# Allow model configs and small files
!models/*.json
!models/*.yaml
!models/*.yml
!models/README.md

# Embeddings (typically large)
embeddings/*.npy
embeddings/*.npz
embeddings/*.pkl
# Allow embeddings configs
!embeddings/*.json
!embeddings/*.yaml
!embeddings/*.yml

# Large data files
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
# Allow small config/example CSV files
!config/*.csv
!data/examples/*.csv
!data/test/*.csv

# Logs and temporary files
*.log
*.tmp
*.temp
logs/
cache/
.cache/

# Environment and secrets
.env
.env.*
!.env.example
.gdrive_cred.json
config/secrets.yaml
config/credentials.yaml

# Database files
*.db
*.sqlite
*.sqlite3

# Experiment tracking
wandb/
mlruns/
.mlflow/
tensorboard_logs/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

