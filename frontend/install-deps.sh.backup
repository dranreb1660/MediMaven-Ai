#!/bin/bash

echo "🔧 Installing missing dependencies for MediMaven frontend..."

# Navigate to frontend directory
cd "$(dirname "$0")"

# Install missing dependencies
echo "📦 Installing @auth0/auth0-react..."
npm install @auth0/auth0-react@^2.2.4

echo "📦 Installing zustand..."
npm install zustand@^4.5.4

echo "✅ Dependencies installed successfully!"
echo ""
echo "🚀 Now you can start the development server:"
echo "   npm run dev"
echo ""
echo "🐛 If you still have issues, check the browser console for any errors."
